# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# Alpha Vantage API key (free tier: 25 requests/day, 5/minute).
# Get one at https://www.alphavantage.co/support/#api-key
# Leave empty to run on bundled mock quotes only.
ALPHA_VANTAGE_API_KEY=

# "live" (default): cache -> Alpha Vantage within budget -> stale cache -> mock.
# "mock": bundled mock quotes only; never calls the network.
MARKET_DATA_MODE=live

# How long a live quote stays fresh in the in-process cache, in seconds.
QUOTE_CACHE_TTL_SECONDS=1800

# OpenAI API key, used by the router and all agents. Required to ask questions.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model for the router and agents. Default: gpt-4o-mini (cheap; available to the course project).
OPENAI_MODEL=gpt-4o-mini
